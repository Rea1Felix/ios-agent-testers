#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

export PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
export PYTHONPATH="${PROJECT_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONUNBUFFERED=1

TERMINAL_PHONE_HOME="${TERMINAL_PHONE_HOME:-${HOME}/Library/Application Support/terminal-phone}"
PYTHON_BIN="${IOS_AGENT_TESTERS_PYTHON:-${TERMINAL_PHONE_HOME}/dependencies/idb-venv/bin/python3}"

if [[ ! -x "${PYTHON_BIN}" ]]; then
  echo "ios-agent-testers: missing terminal-phone idb-venv python3 at ${PYTHON_BIN} (run 'terminal-phone setup' first or set IOS_AGENT_TESTERS_PYTHON)" >&2
  exit 1
fi

exec "${PYTHON_BIN}" -m ios_agent_testers.cli "$@"
